# RESI is its own git clone (origin: statimagcoll/RESI); not tracked here.
# Local modifications to it are synced to the server via rsync (see
# log/claudeLog.md and repo memory for the workflow) until/unless it's
# forked and version-controlled separately.
RESI/

# Simulation output directories (large, regenerable)
*Sim/
sim_raw/

.Rhistory
.Rproj.user/
.DS_Store

# Third-party reference materials (published papers/supplements) kept locally
# for reference only; not redistributed via version control. Original notes
# we write ourselves (e.g. *.qmd) are still tracked.
notes/*.pdf
notes/*.tex
